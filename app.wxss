/**app.wxss**/
/* ==============================
 * 小暖AI备孕助手 - 全局样式
 * ============================== */

page {
  background-color: #FFF6F3;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
}

/* ---------- 通用布局 ---------- */
.container {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.flex-1 {
  flex: 1;
}

/* ---------- 卡片 ---------- */
.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 158, 158, 0.08);
}

/* ---------- 按钮 ---------- */
.btn-primary {
  background: linear-gradient(135deg, #FF9E9E 0%, #FFC1A1 100%);
  color: #FFFFFF;
  border-radius: 40rpx;
  font-size: 30rpx;
  line-height: 80rpx;
  height: 80rpx;
  text-align: center;
}

.btn-secondary {
  background: #FFFFFF;
  color: #FF9E9E;
  border: 2rpx solid #FF9E9E;
  border-radius: 40rpx;
  font-size: 28rpx;
  line-height: 76rpx;
  height: 80rpx;
  text-align: center;
}

/* ---------- 文本 ---------- */
.title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
}

.subtitle {
  font-size: 26rpx;
  color: #999999;
}

.text-primary {
  color: #FF9E9E;
}

/* ---------- 间距 ---------- */
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }

/* ---------- 空状态 ---------- */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: #BBBBBB;
  font-size: 26rpx;
}
