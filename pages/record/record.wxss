/* pages/record/record.wxss */

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #FF4089;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid #F3E8EF;
}

.form-item {
  display: flex;
  flex-direction: column;
}

.form-label {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 12rpx;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 76rpx;
  padding: 0 24rpx;
  background: #FAF7FA;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333333;
}

.picker-arrow {
  color: #CCCCCC;
  font-size: 30rpx;
}

.input-field {
  height: 76rpx;
  padding: 0 24rpx;
  background: #FAF7FA;
  border-radius: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.symptom-list {
  display: flex;
  flex-wrap: wrap;
}

.symptom-tag {
  padding: 16rpx 28rpx;
  border-radius: 30rpx;
  background: #FAF7FA;
  color: #666666;
  font-size: 26rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid transparent;
}

.symptom-tag-active {
  background: #FFE9F2;
  border: 2rpx solid #FF4089;
  color: #FF4089;
  font-weight: 600;
}

/* ---------- 历史记录 ---------- */
.record-list {
  display: flex;
  flex-direction: column;
}

.record-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.record-item:last-child {
  border-bottom: none;
}

.record-date {
  font-size: 28rpx;
  color: #333333;
  font-weight: 600;
}

.record-meta {
  font-size: 22rpx;
  color: #AAAAAA;
  margin-top: 6rpx;
}

.record-delete {
  font-size: 24rpx;
  color: #FF4089;
  padding: 8rpx 16rpx;
}

/* Share the chat page palette; form layout and record behavior are unchanged. */
page {
  background:#f5f5f5;
}
.container {
  background:linear-gradient(180deg,transparent 0,#f5f5f5 650rpx),linear-gradient(115deg,#ffdfed,#efdafa);
}
.card {
  box-shadow:0 4rpx 20rpx rgba(255,64,137,.08);
}
.title,.record-date {
  color:#5c1730;
}
.input-field {
  color:#333333;
}
.btn-primary {
  background:#ff4089;
}
