<view class="chat-page">
<xiaonuan-header bindback="onPageBack" bindnew="onNewConversation" bindhistory="onHistoryClick" bindmore="onHeaderMore"/>
<scroll-view class="msg-list" scroll-y scroll-into-view="{{scrollToId}}" scroll-with-animation bindscroll="onMessageScroll">
<view class="scroll-content">
<view wx:if="{{pageMode === 'home'}}" id="home-top" class="home-content">
 <view class="welcome-banner">
<view class="hero-copy">
<view class="hero-title">Hi,我是小暖</view>
<view class="hero-description">随时为你提供孕期知识和科学建议，陪你记录每一步备孕过程~</view>
</view>
<image class="hero-ip" src="/images/campaign/xiaonuan-heart.png" mode="aspectFit"/>
</view>
 <view class="feature-grid">
<image class="feature-strip" src="/images/campaign/home-features.png" mode="widthFix"/>
<view class="feature-hit-grid">
<view role="button" aria-label="备孕计划" data-question="帮我制定一个备孕计划" bindtap="onWelcomeCardTap"></view>
<view role="button" aria-label="排卵周期" bindtap="openRecordPage"></view>
<view role="button" aria-label="知识科普" data-question="备孕知识科普" bindtap="onWelcomeCardTap"></view>
</view>
</view>
 <view class="faq-heading">
<text>常见问题：</text>
<view bindtap="refreshQuestions">
<image src="/images/ui/refresh-pink.svg"/>换一批</view>
</view>
 <view class="question-pill" wx:for="{{welcomeQuestions}}" wx:key="*this" data-question="{{item}}" bindtap="onWelcomeCardTap">{{item}}</view>
</view>
<view wx:if="{{pageMode === 'consult'}}" id="consult-top" class="consult-content">
 <view class="request-row">
<view class="request-bubble">找备孕师咨询</view>
</view>
 <view class="consult-intro">
<view class="consult-copy">结合<text>备孕阶段、周期情况</text>与咨询需求，<text>智能匹配</text>适合您的备孕师，提供<text>周期管理、排卵指导、试纸解读</text>等专业服务</view>
<view class="expert-panel">
<view class="expert-promises">
<view>科学建议<text>需求匹配</text>
</view>
<view>1V1指导<text>定制服务</text>
</view>
<view>全程陪伴<text>覆盖备孕周期</text>
</view>
</view>
<view class="expert-portraits">
<image class="expert-avatar" src="/images/campaign/advisor-01.png" mode="aspectFit"/>
<image class="expert-avatar" src="/images/campaign/advisor-02.png" mode="aspectFit"/>
<view class="expert-featured">
<image class="expert-avatar" src="/images/campaign/advisor-featured.png" mode="aspectFit"/>
<text>金牌备孕师</text>
</view>
<image class="expert-avatar" src="/images/campaign/advisor-03.png" mode="aspectFit"/>
<image class="expert-avatar" src="/images/campaign/advisor-04.png" mode="aspectFit"/>

</view>
</view>
</view>
 <view class="consult-card">
<view class="consult-top">
<view>AI匹配备孕师 · 深圳<view class="consult-sub">专业1V1 · 定制服务</view>
</view>
<view class="service-history" bindtap="onHistoryClick">服务记录</view>
</view>
<view class="consult-body">
<view class="consult-tabs">
<view class="{{consultTab === 'stage' ? 'tab-active' : ''}}" data-tab="stage" bindtap="changeConsultTab">
<image src="/images/ui/bars.svg"/>按阶段找</view>
<view class="{{consultTab === 'need' ? 'tab-active' : ''}}" data-tab="need" bindtap="changeConsultTab">
<image src="/images/ui/plan-gray.svg"/>按需求找</view>
</view>
<view class="stage-list">
<view wx:for="{{consultTab === 'stage' ? stageQuestions : needQuestions}}" wx:key="*this" data-question="{{item}}" bindtap="onWelcomeCardTap">{{item}}</view>
</view>
<view class="muted">你还可以这样问</view>
<view class="suggestion-links">
<view class="suggestion-tag" data-question="排卵日总是算不准怎么办？" bindtap="onWelcomeCardTap">
<text class="suggestion-hash">#</text><text class="suggestion-label">排卵日总是算不准怎么办？</text></view>
<view class="suggestion-tag" data-question="我的试纸结果怎么看？" bindtap="onWelcomeCardTap">
<text class="suggestion-hash">#</text><text class="suggestion-label">我的试纸结果怎么看？</text></view>
</view>
</view>
</view>
</view>
<block wx:if="{{pageMode === 'chat'}}">
    <!-- 消息列表 -->
    <view
      wx:for="{{messages}}"
      wx:key="id"
      id="msg-{{item.id}}"
      class="msg-row {{item.role === 'user' ? 'msg-row-user' : 'msg-row-assistant'}}"
    >
      <!-- 用户消息：文字 / 图片缩略卡片 / 语音消息 -->
      <user-message
        wx:if="{{item.role === 'user'}}"
        content="{{item.content}}"
        image-url="{{item.imageUrl}}"
        voice-url="{{item.voiceUrl}}"
        voice-duration="{{item.voiceDuration}}"
      />

      <!-- AI消息：小鹿头像 + AI回复卡片（文字问答用ai-message-card，图片分析用ai-image-message） -->
      <block wx:else>
        <view class="assistant-row">

          <view class="assistant-col">
            <ai-image-message
              wx:if="{{item.type === 'image_analysis'}}"
              recognition="{{item.recognition}}"
              analysis="{{item.analysis}}"
              suggestions="{{item.suggestions}}"
              risk-notice="{{item.riskNotice}}"
              data-id="{{item.id}}"
              bindaction="onImageCardAction"
            />
            <ai-message-card
              wx:else
              understanding="{{item.understanding}}"
              analysis="{{item.analysis}}"
              suggestions="{{item.suggestions}}"
              fallback-content="{{item.content}}"
              data-id="{{item.id}}"
              bindaction="onCardAction"
            />

            <!-- 风险提醒卡片：命中高风险时才展示 -->
            <risk-warning-card
              wx:if="{{item.riskLevel === 'high'}}"
              data-id="{{item.id}}"
              bindcontinue="onRiskContinue"
              binddoctor="onRiskDoctor"
            />

            <!-- 用户反馈"这个回答没帮到我" -->
            <view
              class="feedback-btn {{item.dissatisfied ? 'feedback-btn-active' : ''}}"
              data-id="{{item.id}}"
              bindtap="openFeedback"
            >
              {{item.dissatisfied ? '已反馈不满意' : '这个回答没帮到我'}}
            </view>
          </view>
        </view>
      </block>
    </view>

</block>
<view wx:if="{{pageMode === 'assessment'}}" id="assessment-top" class="assessment-wrap">
 <view wx:if="{{assessmentMode === 'intro'}}">
<view class="request-row">
<view class="request-bubble">AI备孕评估</view>
</view>
<view class="assessment-intro">
<view>{{assessmentIntro}}</view>
<view class="privacy-row">对话内容将开启隐私保护 <text>◉</text>
<image src="/images/ui/plan-pink.svg"/>
</view>
<view class="answer-tools"><view class="answer-tools-art">
<image src="/images/campaign/answer-actions.png" mode="aspectFit"/>
<view class="answer-tools-hotspots">
<view role="button" aria-label="朗读" bindtap="onReadUnavailable"></view>
<view role="button" aria-label="复制" data-content="{{assessmentIntro}}" bindtap="onCopy"></view>
<view role="button" aria-label="满意" data-positive="{{true}}" bindtap="openFeedback"></view>
<view role="button" aria-label="不满意" data-positive="{{false}}" bindtap="openFeedback"></view>
</view></view></view>
</view>
</view>
 <view wx:if="{{assessmentMode === 'quiz'}}" class="prior-tools">
<view class="answer-tools"><view class="answer-tools-art">
<image src="/images/campaign/answer-actions.png" mode="aspectFit"/>
<view class="answer-tools-hotspots">
<view role="button" aria-label="朗读" bindtap="onReadUnavailable"></view>
<view role="button" aria-label="复制" data-content="{{assessmentIntro}}" bindtap="onCopy"></view>
<view role="button" aria-label="满意" data-positive="{{true}}" bindtap="openFeedback"></view>
<view role="button" aria-label="不满意" data-positive="{{false}}" bindtap="openFeedback"></view>
</view></view></view>
</view>
 <view wx:if="{{assessmentMode !== 'result'}}" id="assessment-panel" class="assessment-card">
<view class="assessment-head">
<view class="assessment-icon">
<image src="/images/campaign/assessment-calendar.png" mode="aspectFit"/>
</view>
<view class="assessment-heading">备孕状态评估表<view class="muted">请根据您的实际情况进行填写</view>
</view>
<text class="step">{{questionIndex + 1}}/6</text>
</view>
 <view wx:if="{{assessmentMode === 'intro'}}" class="assessment-body intro-body">
<view>请根据您近期实际备孕情况进行填写</view>
<button class="pink-button" bindtap="beginAssessment">开始评估</button>
</view>
 <view wx:else class="assessment-body">
<view class="quiz-title">{{questionIndex + 1}}.{{currentQuestion.title}}<text wx:if="{{questionIndex === 5}}"> （可多选）</text>
</view>
<view wx:for="{{optionItems}}" wx:key="label" class="quiz-option {{item.selected ? 'selected' : ''}}" data-index="{{index}}" bindtap="selectAssessmentOption">{{item.label}}</view>
<button class="pink-button" loading="{{assessmentSubmitting}}" disabled="{{!hasSelection || assessmentSubmitting}}" bindtap="confirmAssessment">确认</button>
<view wx:if="{{questionIndex > 0}}" class="previous" bindtap="previousAssessment">上一题</view>
</view>
</view>
 <view wx:if="{{assessmentMode === 'quiz'}}" class="small-rating">
<image src="/images/ui/like.svg" data-positive="{{true}}" bindtap="openFeedback"/>
<image class="dislike-icon" src="/images/ui/like.svg" data-positive="{{false}}" bindtap="openFeedback"/>
</view>
 <block wx:if="{{assessmentMode === 'result'}}">
<view class="completion-banner">
<image src="/images/ui/calendar-pink.svg"/>
<view>
<text>自测完成：备孕状态评估表</text>
<view>已完成检测，将结合询问给出建议</view>
</view>
<image class="completion-check" src="/images/campaign/report-complete.png" mode="aspectFit"/>
</view>
<view class="request-row">
<view class="request-bubble">▤ 已完成自测</view>
</view>
<view id="assessment-report" class="report-card">
<view class="report-hero">
<view>
<view class="report-title">备孕状态评估结果</view>
<view class="score-badge">{{reportScore === null ? '待完善' : reportScore}}<text wx:if="{{reportScore !== null}}"> 分</text>
</view>
<view class="dimension-button" bindtap="openReportDimensions">测试维度 ›</view>
</view>
<view class="orbit">
<image class="gauge-art" src="/images/campaign/report-gauge.png" mode="aspectFit"/>
<view class="score-dial gauge-dial"><view class="score-center"></view><view wx:if="{{reportScore !== null}}" class="score-pointer" style="transform:rotate({{pointerAngle}}deg)"><view></view></view></view>
</view>
</view>
<view class="muted report-disclaimer">Demo自评规则分，不代表诊断、生育能力或受孕概率</view>
<view class="report-title">已完成备孕状态分析</view>
<view class="report-copy">{{assessmentReport.summary}}</view>
<view wx:for="{{reportAnalysis}}" wx:key="title" class="analysis-line">
<text class="answer-number">{{index + 1}}</text>
<view>
<text class="analysis-title">{{item.title}}：</text>{{item.content}}</view>
</view>
<view class="report-title health-title">健康建议 · {{scoreLabel}}</view>
<view wx:for="{{assessmentReport.suggestions}}" wx:key="*this" class="report-copy">
<text class="analysis-title">{{index + 1}}. </text>{{item}}</view>
<view class="muted report-disclaimer">建议由Demo规则模板生成，仅供参考；持续不适请及时就医</view>
<view class="report-footer">
<image class="report-feedback-art" src="/images/campaign/report-feedback.png" mode="widthFix"/>
<view class="rating-hit" role="button" aria-label="你对本次备孕评估满意吗？" bindtap="openFeedback"></view>
<view class="answer-tools"><view class="answer-tools-art">
<image src="/images/campaign/answer-actions.png" mode="aspectFit"/>
<view class="answer-tools-hotspots">
<view role="button" aria-label="朗读" bindtap="onReadUnavailable"></view>
<view role="button" aria-label="复制" data-content="{{assessmentIntro}}" bindtap="onCopy"></view>
<view role="button" aria-label="满意" data-positive="{{true}}" bindtap="openFeedback"></view>
<view role="button" aria-label="不满意" data-positive="{{false}}" bindtap="openFeedback"></view>
</view></view></view>
</view>
</view>
</block>
</view>
<view wx:if="{{loading}}" class="loading-bubble">小暖正在思考中...</view>
<view id="chat-bottom" class="scroll-end">
</view>
</view>
</scroll-view>
<view wx:if="{{showScrollShortcut}}" class="scroll-shortcut" role="button" aria-label="滚动到底部"><image src="/images/campaign/scroll-down.png" mode="aspectFit"/><view class="scroll-shortcut-hit" bindtap="onScrollShortcut"></view></view>
  <!-- AI咨询兜底提示卡：命中触发条件后展示 -->
  <view wx:if="{{showHandoffBanner}}" class="handoff-banner">
    <view class="handoff-banner-close" bindtap="onCloseHandoffBanner">×</view>
    <view class="handoff-banner-title">建议咨询专业医生</view>
    <view class="handoff-banner-desc">
      {{handoffReason === 'high_risk' ? '你提到的情况可能需要专业医生当面判断' : (handoffReason === 'unresolved_streak' ? 'AI好像没能连续解决你的问题' : '已收到你的反馈') }}，为了不耽误你，建议直接寻求专业咨询。
    </view>
    <view class="handoff-banner-btn" bindtap="onGoHandoff">人工咨询入口</view>
  </view>


<view wx:if="{{pageMode === 'home' || assessmentMode === 'quiz'}}" class="privacy-note">继续沟通代表您已阅读并同意 <text bindtap="onServiceNotice">《服务声明》</text>
</view>
<view class="bottom-dock">
<scroll-view scroll-x class="service-bar" show-scrollbar="{{false}}">
<view class="service-track">
<view class="service-chip service-chip-art" role="button" aria-label="咨询备孕师" bindtap="openConsult"><image src="/images/campaign/shortcut-consult.png" mode="aspectFit"/></view>
<view class="service-chip service-chip-art" role="button" aria-label="AI备孕评估" bindtap="openAssessment"><image src="/images/campaign/shortcut-assessment.png" mode="aspectFit"/></view>
<view class="service-chip service-chip-art" role="button" aria-label="报告单解读" bindtap="onPlusClick"><image src="/images/campaign/shortcut-report.png" mode="aspectFit"/></view>
<view class="service-chip service-chip-art" role="button" aria-label="用药建议" bindtap="onMedicationAdvice"><image src="/images/campaign/shortcut-medication.png" mode="aspectFit"/></view>
</view>
</scroll-view>
<chat-input value="{{inputValue}}" bindinput="onInputChange" bindconfirm="onSend" bindunavailable="onInputUnavailable" bindplus="onPlusClick" bindvoicesend="onVoiceSend"/>
</view>
<image-picker show="{{showImagePicker}}" bindselect="onImagePickerSelect" bindcancel="onImagePickerCancel"/>
<image-preview-card show="{{!!pendingImage}}" image-url="{{pendingImage}}" caption="{{pendingCaption}}" bindcaptioninput="onPendingCaptionInput" bindcancel="onImagePreviewCancel" bindsend="onImagePreviewSend"/>
<view wx:if="{{showFeedback}}" class="feedback-mask" bindtap="closeFeedback">
<view class="feedback-sheet" catchtap="stopTap">
<view class="feedback-title">反馈<view class="feedback-close" bindtap="closeFeedback">
<image src="/images/ui/close.svg"/>
</view>
</view>
<view class="sentiment">
<view data-positive="{{true}}" bindtap="chooseSentiment">
<view class="sentiment-circle {{feedbackPositive ? 'chosen' : ''}}">
<image src="{{feedbackPositive ? '/images/ui/like-pink.svg' : '/images/ui/like-gray.svg'}}"/>
</view>
<text class="{{feedbackPositive ? 'sentiment-label-active' : ''}}">满意</text>
</view>
<view data-positive="{{false}}" bindtap="chooseSentiment">
<view class="sentiment-circle {{!feedbackPositive ? 'chosen' : ''}}">
<image class="dislike-icon" src="{{!feedbackPositive ? '/images/ui/like-pink.svg' : '/images/ui/like-gray.svg'}}"/>
</view>
<text class="{{!feedbackPositive ? 'sentiment-label-active' : ''}}">不满意</text>
</view>
</view>
<view class="feedback-tags">
<view wx:for="{{feedbackTags}}" wx:key="label" class="feedback-tag {{item.selected ? 'active' : ''}}" data-index="{{index}}" bindtap="toggleFeedbackTag">{{item.label}}</view>
</view>
<view class="feedback-caption">补充描述：</view>
<textarea class="feedback-textarea" placeholder="（选填）请描述具体问题，有助于我们更好的服务（200字以内）" maxlength="200" value="{{feedbackText}}" bindinput="onFeedbackInput"/>
<button class="pink-button" bindtap="submitFeedback">反馈</button>
</view>
</view>
<view wx:if="{{showDimensions}}" class="dimensions-page">
<view class="dimensions-back" bindtap="closeReportDimensions">
<image src="/images/ui/back.svg"/>返回报告</view>
<image class="dimensions-ip" src="/images/campaign/xiaonuan-celebration-scene.png" mode="aspectFit"/>
<view class="dimensions-status">{{scoreLabel}}</view>
<view class="muted">备孕状态自评维度 · Demo规则</view>
<view class="dimensions-card">
<view class="dimensions-title">备孕状态分析</view>
<canvas type="2d" id="radar-canvas" class="radar-canvas">
</canvas>
<view class="dimension-summary">
<view>{{reportScore === null ? '信息不足，暂无法计算总分' : '本次自评 ' + reportScore + ' 分'}}</view>
<view wx:if="{{reportScore !== null}}" class="dimension-progress">
<view style="width:{{reportScore}}%">
</view>
</view>
<view class="muted">{{assessmentReport.summary}}</view>
</view>
<view class="muted dimensions-note">Demo规则未经医学验证，请结合具体症状和医生建议</view>
<view class="dimensions-actions">
<button class="soft-button" bindtap="closeReportDimensions">查看详细报告</button>
<button class="pink-button" bindtap="onPlanFromReport">生成备孕计划</button>
</view>
</view>
</view>
</view>
