/* pages/chat/chat.wxss */
/* 配色规范：Primary #FF8FA3 / Background #FFF8FA / Card #FFFFFF / Text #333333 / Secondary #999999 */

.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #FFF8FA;
  box-sizing: border-box;
  padding-bottom: calc(112rpx + env(safe-area-inset-bottom)); /* 给底部固定输入栏预留空间 */
}

.chat-input-fixed {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
}

.msg-list {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
}

/* ============ 首页欢迎状态 ============ */

.welcome {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 24rpx 40rpx;
}

.welcome-title {
  margin-top: 24rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
}

.welcome-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #999999;
}

.welcome-grid {
  width: 100%;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 32rpx;
}

.welcome-card {
  width: 48%;
  margin-bottom: 20rpx;
  background: #FFFFFF;
  border-radius: 20px;
  padding: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 16rpx rgba(255, 143, 163, 0.12);
}

.welcome-card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.welcome-card-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999999;
}

.welcome-start-btn {
  margin-top: 40rpx;
  width: 60%;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #FFFFFF;
  background: linear-gradient(135deg, #FFB3C1 0%, #FF8FA3 100%);
  border-radius: 16px;
  box-shadow: 0 6rpx 16rpx rgba(255, 143, 163, 0.35);
}

/* ============ 消息列表 ============ */

.msg-row {
  display: flex;
  margin-bottom: 24rpx;
}

.msg-row-user {
  justify-content: flex-end;
}

.msg-row-assistant {
  justify-content: flex-start;
}

.assistant-row {
  display: flex;
  align-items: flex-start;
  max-width: 100%;
}

.assistant-col {
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  max-width: calc(100% - 96rpx);
}

.loading-bubble {
  margin-left: 16rpx;
  padding: 20rpx 24rpx;
  background: #FFFFFF;
  color: #999999;
  border-radius: 20px;
  border-top-left-radius: 8rpx;
  font-size: 26rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

/* 不满意反馈按钮 */
.feedback-btn {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #B0A3A6;
  padding: 4rpx 16rpx;
  border: 1rpx solid #F0E0E3;
  border-radius: 20px;
  display: inline-block;
}

.feedback-btn-active {
  color: #FF8FA3;
  border-color: #FF8FA3;
}

/* ============ AI咨询兜底提示卡 ============ */

.handoff-banner {
  position: relative;
  margin: 0 24rpx 16rpx;
  padding: 24rpx;
  background: #FFF0EC;
  border: 1rpx solid #FFC1A1;
  border-radius: 20px;
}

.handoff-banner-close {
  position: absolute;
  top: 12rpx;
  right: 20rpx;
  font-size: 32rpx;
  color: #C9958A;
  line-height: 1;
}

.handoff-banner-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #D9534F;
}

.handoff-banner-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8A5B52;
  line-height: 1.5;
}

.handoff-banner-btn {
  margin-top: 16rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 26rpx;
  color: #FFFFFF;
  background: linear-gradient(135deg, #FFB3C1 0%, #FF8FA3 100%);
  border-radius: 16px;
}

.chat-page { background: linear-gradient(130deg,#fbd9e9 0,#eddcfa 14%,#f5f5f6 32%); color:#602139; }
.msg-list { min-height:0; padding:24rpx 28rpx; }
.welcome { display:block; padding:30rpx 0; }
