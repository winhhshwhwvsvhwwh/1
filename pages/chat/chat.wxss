.assessment-intro { background:white; border-radius:24rpx; padding:30rpx; font-size:27rpx; line-height:1.8; margin-bottom:28rpx; color:#333; }.assessment-card { border:2rpx solid white; border-radius:30rpx; overflow:hidden; background:#faf0f5; }.assessment-head { display:flex; align-items:center; background:#fffafa; padding:28rpx; gap:18rpx; }.assessment-icon { color:#ff4089; background:#ffe4ef; padding:10rpx; font-size:40rpx; border-radius:14rpx; }.assessment-heading { flex:1; font-size:28rpx; font-weight:600; }.muted { font-size:22rpx; color:#aaa; line-height:1.7; font-weight:normal; margin-top:8rpx; }.step { background:#fce1eb; color:#ba5374; border-radius:30rpx; padding:6rpx 18rpx; font-size:22rpx; }.assessment-body { padding:28rpx; }.intro-copy { margin:20rpx 0 50rpx; font-size:28rpx; }.quiz-title { font-size:29rpx; font-weight:600; margin-bottom:24rpx; }.quiz-option { border:2rpx solid transparent; border-radius:60rpx; padding:22rpx 30rpx; background:white; margin-bottom:22rpx; font-size:26rpx; }.quiz-option.selected { border-color:#ff4089; color:#ff4089; }.pink-button { background:#ff4089; border-radius:60rpx; color:white; font-size:30rpx; margin-top:20rpx; }.pink-button::after,.soft-button::after { border:0; }.pink-button[disabled] { background:#f2b4cc; color:white; }.previous { text-align:center; padding-top:24rpx; color:#aa6981; font-size:24rpx; }.report-card { padding:30rpx; border:2rpx solid white; border-radius:30rpx; background:linear-gradient(145deg,#fff0f7,white 35%); }.report-label { color:#9d5970; font-size:24rpx; }.report-title { font-size:30rpx; font-weight:600; margin:30rpx 0 20rpx; }.report-badge { display:inline-block; padding:16rpx 24rpx; background:#ff4089; color:white; border-radius:20rpx; }.report-copy { font-size:27rpx; line-height:1.9; white-space:pre-wrap; margin-bottom:16rpx; }.answer-summary { display:flex; gap:16rpx; font-size:26rpx; margin:20rpx 0; }.answer-number { background:#ff4089; color:white; border-radius:6rpx; height:30rpx; padding:0 8rpx; }.answer-value { color:#a26b80; margin-top:8rpx; }.report-actions { display:flex; gap:16rpx; }.report-actions button { flex:1; font-size:26rpx; }.soft-button { background:#fff0f6; color:#ff4089; border-radius:60rpx; margin-top:20rpx; }.rating { border-top:1rpx solid #eee; padding-top:28rpx; margin-top:30rpx; font-size:24rpx; }.rating text { color:#ff4089; margin-left:14rpx; }.assessment-wrap { margin-bottom:30rpx; }
.feedback-mask { position:fixed; inset:0; background:rgba(30,20,27,.4); display:flex; align-items:flex-end; z-index:150; }.feedback-sheet { width:100%; box-sizing:border-box; padding:32rpx 36rpx calc(30rpx + env(safe-area-inset-bottom)); background:white; border-radius:40rpx 40rpx 0 0; }.feedback-title { text-align:center; font-size:34rpx; color:#333; position:relative; }.feedback-close { position:absolute; right:0; }.sentiment { display:flex; justify-content:center; gap:100rpx; padding:38rpx; color:#ccc; font-size:60rpx; text-align:center; }.sentiment view view { font-size:24rpx; }.active { color:#ff4089; background:#fff0f6; }.feedback-tags { display:flex; flex-wrap:wrap; gap:16rpx; }.feedback-tag { background:#f5f5f6; border-radius:30rpx; padding:10rpx 24rpx; font-size:24rpx; }.feedback-tag.active { color:#ff4089; background:#ffe8f1; }.feedback-textarea { background:#fafafa; width:100%; box-sizing:border-box; height:190rpx; padding:24rpx; margin:30rpx 0; font-size:26rpx; border-radius:16rpx; }.feedback-local { text-align:center; }

