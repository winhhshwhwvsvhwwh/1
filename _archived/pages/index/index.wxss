/* pages/index/index.wxss */

/* ---------- AI IP 问候区 ---------- */
.ip-banner {
  display: flex;
  align-items: center;
  padding: 12rpx 8rpx 32rpx;
}

.ip-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFE1D6 0%, #FFC1A1 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}

.ml-20 {
  margin-left: 20rpx;
}

.ip-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.ip-greeting {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
  max-width: 480rpx;
}

/* ---------- 今日备孕状态卡片 ---------- */
.status-card {
  background: linear-gradient(135deg, #FFFFFF 0%, #FFF6F3 100%);
  border: 2rpx solid #FFE8E1;
}

.status-tag {
  background: #FFF0EC;
  color: #FF9E9E;
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
}

.progress-bg {
  height: 16rpx;
  background: #F5EFE9;
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #A8DDC0 0%, #FF9E9E 100%);
  border-radius: 8rpx;
}

.status-detail {
  display: flex;
  justify-content: space-between;
}

.status-item {
  display: flex;
  flex-direction: column;
}

.status-item-label {
  font-size: 22rpx;
  color: #AAAAAA;
}

.status-item-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-top: 8rpx;
}

/* ---------- 四宫格 ---------- */
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.grid-item {
  position: relative;
  width: 48%;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 158, 158, 0.08);
  box-sizing: border-box;
}

.grid-icon {
  font-size: 48rpx;
}

.grid-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-top: 12rpx;
}

.grid-desc {
  font-size: 22rpx;
  color: #AAAAAA;
  margin-top: 8rpx;
}

.grid-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  font-size: 18rpx;
  color: #7FBF9A;
  background: #EAF6EF;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}

/* ---------- 会员入口 ---------- */
.member-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #FFD9A0 0%, #FFC1A1 100%);
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-top: 8rpx;
}

.member-banner-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #7A4A1E;
}

.member-banner-desc {
  font-size: 22rpx;
  color: #8A5A2E;
  margin-top: 8rpx;
}

.member-banner-arrow {
  font-size: 40rpx;
  color: #7A4A1E;
}
