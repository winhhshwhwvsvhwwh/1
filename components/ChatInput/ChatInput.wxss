/* 输入文字与左右图标使用同一条垂直中心线。 */
.chat-input-bar {
  display:flex;
  align-items:center;
  box-sizing:border-box;
  height:96rpx;
  margin:0 32rpx;
  padding:8rpx 16rpx;
  background:#FFFFFF;
  border:0;
  border-radius:60rpx;
}
.chat-input-icon {
  display:flex;
  align-items:center;
  justify-content:center;
  flex:0 0 54rpx;
  width:54rpx;
  height:64rpx;
}
.input-line-icon {
  display:block;
  width:48rpx;
  height:48rpx;
}
.chat-input-box {
  flex:1;
  min-width:0;
  align-self:center;
  box-sizing:border-box;
  height:48rpx;
  line-height:48rpx;
  padding:0 12rpx;
  margin:0;
  border:0;
  background:transparent;
  font-size:27rpx;
  color:#333333;
}
.voice-icon-active {
  background:#FFF0F3;
  border-radius:50%;
}

/* ============ 语音录制浮层：按住说话时展示 ============ */

.voice-recording-mask {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  top: 0;
  background: rgba(0, 0, 0, 0.15);
  z-index: 120;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none; /* 不拦截手指移动，触摸事件继续由麦克风按钮本身接收 */
}

.voice-recording-panel {
  width: 320rpx;
  padding: 48rpx 0 36rpx;
  background: rgba(40, 40, 40, 0.88);
  border-radius: 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: background-color 0.15s;
}

.voice-recording-panel-cancel {
  background: rgba(224, 87, 63, 0.92);
}

.voice-recording-icon {
  font-size: 64rpx;
}

.voice-recording-timer {
  margin-top: 16rpx;
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.voice-recording-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}
