/* components/ImagePicker/ImagePicker.wxss */
/* 主色#F8A7B8 / 背景#FFF8FA / 圆角16px，保持小暖UI风格 */

.ip-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.ip-sheet {
  width: 100%;
  background: #FFF8FA;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.ip-sheet-title {
  text-align: center;
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 20rpx;
}

.ip-option {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 16px;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(248, 167, 184, 0.1);
}

.ip-option:active {
  background: #FFF0F3;
}

.ip-option-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #FFF0F3;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.ip-option-text {
  margin-left: 20rpx;
  flex: 1;
}

.ip-option-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.ip-option-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #999999;
}

.ip-cancel {
  margin-top: 8rpx;
  text-align: center;
  background: #FFFFFF;
  border-radius: 16px;
  padding: 22rpx 0;
  font-size: 28rpx;
  color: #F8A7B8;
  font-weight: 500;
}

.ip-cancel:active {
  background: #FFF0F3;
}
