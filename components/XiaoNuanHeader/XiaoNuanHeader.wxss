.xn-header {
  flex-shrink:0;
  background:linear-gradient(115deg,#ffdfed,#efdafa);
}
.xn-header-row {
  display:flex;
  align-items:center;
  box-sizing:border-box;
  min-height:44px;
  padding-left:24rpx;
}
.xn-header-back {
  width:36rpx;
  height:72rpx;
  margin-right:8rpx;
  flex-shrink:0;
  display:flex;
  align-items:center;
  justify-content:center;
}
.xn-header-back image { width:48rpx; height:48rpx; flex-shrink:0; }
.xn-header-info { flex:1; min-width:0; }
.xn-header-name {
  font-size:30rpx;
  line-height:1.25;
  white-space:nowrap;
  font-weight:600;
  color:#222;
}
.xn-header-sub {
  font-size:20rpx;
  line-height:1.3;
  color:#aaa0a7;
  margin-top:2rpx;
}
.xn-header-action {
  display:flex;
  align-items:center;
  justify-content:center;
  flex-shrink:0;
  width:72rpx;
  height:72rpx;
  border-radius:50%;
  background:#fff;
  margin-left:12rpx;
}
.xn-header-action image { width:44rpx; height:44rpx; }
