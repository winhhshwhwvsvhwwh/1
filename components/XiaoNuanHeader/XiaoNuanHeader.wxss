.xn-header {
  flex-shrink:0}
.xn-header-row {
  display:flex;
  align-items:center;
  box-sizing:border-box;
  min-height:40px}
.xn-header-back {
  width:42rpx;
  display:flex;
  align-items:center;
  justify-content:center}
.xn-header-back image {
  width:30rpx;
  height:36rpx}
.xn-header-info {
  flex:1;
  min-width:0}
.xn-header-name {
  font-size:26rpx;
  font-weight:600;
  color:#222}
.xn-header-sub {
  font-size:18rpx;
  color:#b3a8af;
  margin-top:2rpx}
.xn-header-action {
  display:flex;
  align-items:center;
  justify-content:center;
  width:58rpx;
  height:58rpx;
  border-radius:50%;
  background:#fff;
  margin-right:12rpx}
.xn-header-action image {
  width:38rpx;
  height:38rpx}
