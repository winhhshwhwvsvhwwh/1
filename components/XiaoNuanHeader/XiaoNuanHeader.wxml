<view class="xn-header" style="padding-top:{{statusBarHeight}}px">
<view class="xn-header-row" style="height:{{navigationHeight}}px;padding-right:{{menuWidth}}px">
<view class="xn-header-back" bindtap="onBack">
<image src="/images/ui/back.svg"/>
</view>
<view class="xn-header-info">
<view class="xn-header-name">小暖AI备孕助手</view>
<view class="xn-header-sub">内容由AI生成</view>
</view>
<view class="xn-header-action" bindtap="onNew">
<image src="/images/ui/plus.svg"/>
</view>
<view class="xn-header-action" bindtap="onHistory">
<image src="/images/ui/clock.svg"/>
</view>
</view>
</view>
