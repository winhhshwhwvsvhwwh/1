<!--components/AIMessageCard/AIMessageCard.wxml-->
<view class="ai-card">

  <!-- 顶部：icon + 标题 -->
  <view class="ai-card-header">
    <text class="ai-card-title">🌸 小暖分析</text>
    <view class="ai-card-copy" role="button" aria-label="复制完整回答" data-action="copy" bindtap="onActionTap">复制文字</view>
  </view>

  <!-- 内容区域：支持长文本展开/收起 -->
  <view class="ai-card-body">
    <block wx:if="{{expanded || !isLong}}">
      <view class="ai-card-text" wx:if="{{understanding}}"><text wx:for="{{understandingSegments}}" wx:for-item="segment" wx:key="id" class="{{segment.highlighted ? 'ai-card-highlight' : ''}}">{{segment.text}}</text></view>
      <view class="ai-card-text" wx:if="{{analysis}}"><text wx:for="{{analysisSegments}}" wx:for-item="segment" wx:key="id" class="{{segment.highlighted ? 'ai-card-highlight' : ''}}">{{segment.text}}</text></view>
      <view class="ai-card-text" wx:if="{{!understanding && !analysis && fallbackContent}}"><text wx:for="{{fallbackSegments}}" wx:for-item="segment" wx:key="id" class="{{segment.highlighted ? 'ai-card-highlight' : ''}}">{{segment.text}}</text></view>
    </block>
    <block wx:else>
      <view class="ai-card-text"><text wx:for="{{previewSegments}}" wx:for-item="segment" wx:key="id" class="{{segment.highlighted ? 'ai-card-highlight' : ''}}">{{segment.text}}</text></view>
    </block>

    <view wx:if="{{isLong}}" class="ai-card-toggle" bindtap="onToggleExpand">
      {{expanded ? '收起' : '展开全部'}}
      <text class="ai-card-toggle-arrow">{{expanded ? '︿' : '﹀'}}</text>
    </view>
  </view>

  <!-- 建议：小暖建议 -->
  <view wx:if="{{suggestions && suggestions.length > 0}}" class="ai-card-suggestions">
    <view class="ai-card-suggestion-item" wx:for="{{suggestionRows}}" wx:key="id">
      <text class="ai-card-suggestion-check">✓</text>
      <text class="ai-card-suggestion-text"><text wx:for="{{item.segments}}" wx:for-item="segment" wx:key="id" class="{{segment.highlighted ? 'ai-card-highlight' : ''}}">{{segment.text}}</text></text>
    </view>
  </view>

  <!-- 底部操作按钮：周期记录 / 继续咨询（原"查看我的周期"和"记录今天状态"跳转的是同一个页面，合并成一个按钮） -->
  <view class="ai-card-actions">
    <view class="ai-card-action-btn" data-action="record" bindtap="onActionTap">周期记录</view>
    <view class="ai-card-action-btn" data-action="continue" bindtap="onActionTap">继续咨询</view>
  </view>

  <view wx:if="{{riskNotice && riskNotice !== analysis && riskNotice !== '以上为备孕科普参考，不替代医生诊断。'}}" class="ai-card-disclaimer">{{riskNotice}}</view>
  <view class="ai-card-disclaimer">以上为备孕科普参考，不替代医生诊断。</view>
</view>
